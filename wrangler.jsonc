{
  "name": "lemvori-shift",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/webhook"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lemvori-shift-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ],
  "triggers": { "crons": ["0 * * * *"] }
}
